# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=endpointdaal
AZURE_OPENAI_API_KEY="API_KEY_DAAL_LASADLE"
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=model daal         # main answer model
AZURE_OPENAI_MINI_DEPLOYMENT=          # optional cheap model for ingestion/routing/rerank (falls back to chat)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=     # must be a text-embedding-3-* deployment (supports `dimensions`)
EMBEDDING_DIM=1024                     # must match halfvec(1024) in the DB
# LLM_TEMPERATURE=0.2                  # leave empty for reasoning models (o-series / gpt-5) that reject temperature

# ---- Supabase (RajProject) ----
SUPABASE_URL=daalkey
SUPABASE_SERVICE_ROLE_KEY=keydaal            # server-side only. Never ship to the browser or commit.

# ---- Sources ----
ELEVENLABS_API_KEY=daalde
SCRIBE_MODEL=scribe_v2
YOUTUBE_API_KEY=daalde                   # optional; without it discovery falls back to yt-dlp (slower)
# YOUTUBE_PROXY_URL=                   # only if YouTube blocks your IP when fetching captions
FO_PLAYLIST_ID=kk

# ---- Tuning (defaults are fine) ----
# SELECT_TOP_POPULAR=8   SELECT_TOP_DEEP=8   SELECT_RECENT=25
# INGEST_CONCURRENCY=4   RERANK_ENABLED=true  MAX_CONTEXT_SOURCES=10
# CORS_ORIGINS=http://localhost:8000
